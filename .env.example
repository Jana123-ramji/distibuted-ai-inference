# ---------------------------------------------------------------------------
# Example configuration. Copy to .env and edit:  cp .env.example .env
# .env is git-ignored. NEVER put real secrets in .env.example.
# This project needs no API keys, passwords or tokens by design.
# ---------------------------------------------------------------------------

# ----- shared -----
# Python log level for every service: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ----- API gateway -----
API_HOST=0.0.0.0
API_PORT=8000
# Worker selection strategy. Only "least_loaded" exists in v1.
SCHEDULER_STRATEGY=least_loaded
# A worker with no heartbeat for this long is marked unhealthy (seconds).
HEARTBEAT_TIMEOUT_SECONDS=15
# How long the API waits for a worker's inference reply (seconds).
INFERENCE_TIMEOUT_SECONDS=120
# How many different healthy workers to try before giving up.
MAX_WORKER_RETRIES=2

# ----- worker -----
# Where the worker registers itself and sends heartbeats.
# Docker Compose: http://api:8000   |  Kubernetes: http://api-service:8000
API_URL=http://localhost:8000
WORKER_HOST=0.0.0.0
WORKER_PORT=8001
# Address the API should call back on. Leave empty to auto-detect
# (POD_IP in Kubernetes, container hostname in Docker).
WORKER_ADVERTISE_HOST=
# Worker identity. Leave empty to derive from POD_NAME / hostname.
# Never hardcode this in Kubernetes.
WORKER_ID=
# Seconds between heartbeats sent to the API.
HEARTBEAT_INTERVAL_SECONDS=5

# ----- inference -----
# auto     = use MAX if importable, otherwise the CPU fallback
# max      = force the MAX backend (fail loudly if unavailable)
# fallback = force the CPU transformers backend
INFERENCE_BACKEND=auto
# Small instruct model that fits on a CPU-only laptop.
MODEL_ID=HuggingFaceTB/SmolLM2-135M-Instruct
MAX_NEW_TOKENS=96
# Where downloaded model weights are cached inside the container.
HF_HOME=/models

# ----- Mojo preprocessing -----
# true = call the compiled Mojo binary; false = use the Python reference version
MOJO_ENABLED=true
# Path to the compiled Mojo preprocessing binary inside the container.
MOJO_BINARY=/app/mojo/preprocess

# ----- injected by Kubernetes (do not set by hand) -----
# POD_NAME=
# POD_IP=
